{
  "name": "@grassquest/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/main.js",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node src/migrate.ts",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/throttler": "^6.4.0",
    "mongoose": "^8.19.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.20.6",
    "@types/node": "^22.18.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.10"
  }
}
